#!/data/data/com.termux/files/usr/bin/sh
# npud boot script — install to ~/.termux/boot/20-npud (chmod 700).
#
# Termux:Boot runs these at boot; this follows the same shape as the existing
# start-ssh. Deliberately NOT an Android init service: npud must run as the
# Termux UID (the model dir and workers already expect it), and this ROM builds
# with PRODUCT_PRIVATE_SEPOLICY_DIRS disabled, so a new SELinux domain isn't
# available. Deliberately not runit either — termux-services isn't installed
# here; the leftover $PREFIX/var/service dirs have no supervisor behind them.
#
# Numbered 20 so it lands after wake-lock/ssh setup.
PREFIX=/data/data/com.termux/files/usr
HOME_DIR=/data/data/com.termux/files/home

# Termux:Boot does not always export a usable PATH, and this script is also
# runnable by hand from a root shell where it definitely isn't set.
PATH="$PREFIX/bin:$PATH"
export PATH

termux-wake-lock 2>/dev/null || true

# Model weights are file-backed mmaps (~3.7 GB resident for Gemma 1B), so the
# kernel can evict them under pressure and the next request pays a re-read. The
# 64 KB default ceiling is useless for that; best-effort raise, and npud still
# runs if the shell refuses.
ulimit -l unlimited 2>/dev/null || true

export NPUD_CONF="$HOME_DIR/.config/npud/npud.conf"
export NPUD_MODEL_DIR="$HOME_DIR/npu_models"
export NPUD_SOCKET="$PREFIX/tmp/npud.sock"
export NPUD_DISPATCH_DIR=/data/local/tmp/agora

# NPUD_PRELOAD=1 loads every discovered model at startup. Check total RAM against
# the models present first: each resident LLM costs roughly its file size in RSS,
# so preloading several will not fit in 16 GB. Without it models load on first
# use and stay warm, which is usually what you want.
exec "$PREFIX/bin/npud" >> "$PREFIX/tmp/npud.log" 2>&1
