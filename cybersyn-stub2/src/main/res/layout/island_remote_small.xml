<?xml version="1.0" encoding="utf-8"?>
<!-- GENERIC island remote (shader-backdrop scope.md 2026-11-01 REMOTES PER SHADER): IslandRemote fills the
     button / switch texts from the active shader's pad at runtime; empty rows and buttons are hidden. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="4dp">
    <TextView android:id="@+id/isl_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFB0B0C0" android:textSize="12sp" android:singleLine="true" android:text="DESK remote" />
    <LinearLayout android:id="@+id/isl_r0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/isl_b0" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="0dp"
            android:padding="0dp" android:textSize="12sp" android:textAllCaps="false" android:singleLine="true"
            android:textColor="#FFE6E6E6" android:backgroundTint="#FF2E2E3A" android:text="isl_b0" android:visibility="gone" />
        <Button android:id="@+id/isl_b1" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="0dp"
            android:padding="0dp" android:textSize="12sp" android:textAllCaps="false" android:singleLine="true"
            android:textColor="#FFE6E6E6" android:backgroundTint="#FF2E2E3A" android:text="isl_b1" android:visibility="gone" />
        <Button android:id="@+id/isl_b2" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="0dp"
            android:padding="0dp" android:textSize="12sp" android:textAllCaps="false" android:singleLine="true"
            android:textColor="#FFE6E6E6" android:backgroundTint="#FF2E2E3A" android:text="isl_b2" android:visibility="gone" />
        <Button android:id="@+id/isl_b3" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="2dp" android:minWidth="0dp" android:minHeight="0dp"
            android:padding="0dp" android:textSize="12sp" android:textAllCaps="false" android:singleLine="true"
            android:textColor="#FFE6E6E6" android:backgroundTint="#FF2E2E3A" android:text="isl_b3" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
